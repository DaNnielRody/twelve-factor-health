# Copy to .env for local development: cp .env.example .env
# Every variable is optional; the value shown is the default used when unset.
# Real deploys inject these through the platform (compose, Vercel, systemd...), never through a committed file.

# Factor VII - port binding. The service binds to whatever PORT the environment provides.
PORT=3000
# Interface to bind. 0.0.0.0 inside containers; 127.0.0.1 to keep it local-only.
HOST=0.0.0.0

# Factor XI - logs. JSON lines to stdout: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
SERVICE_NAME=twelve-factor-health

# Factor IV - backing service. Leave empty to run detached (/api/hits returns 503).
# Inside compose: redis://redis:6379   Host run against compose redis: redis://localhost:6379
REDIS_URL=

# Factor IX - max time to drain in-flight requests after SIGTERM before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# Factor V - release identity. Set by scripts/build.sh / the platform, not by hand.
RELEASE_VERSION=dev
NODE_ENV=development

# Deploy only (compose profile "tunnel"): token of a Cloudflare Zero Trust named tunnel.
# Secret - never commit the real value.
TUNNEL_TOKEN=
